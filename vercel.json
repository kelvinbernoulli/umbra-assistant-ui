{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://umbra-assistant.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://umbra-assistant.onrender.com/health" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
